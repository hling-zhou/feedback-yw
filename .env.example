# 复制为 .env 后，运行 `npm run dev:api` / `npm run dev:all` 会自动加载（见 server/loadEnv.js）
# API 启动必填，至少 16 字符；生产环境请使用 openssl rand -base64 32 生成
JWT_SECRET=replace-with-local-dev-secret-at-least-16-chars

# 可选（开发默认允许 127.0.0.1:5175 / localhost:5175；生产环境必填）
# CORS_ORIGINS=http://127.0.0.1:5175,http://localhost:5175

# 可选
# JWT_EXPIRES_IN=7d
# API_PORT=3001
# API_HOST=127.0.0.1
# API_BODY_LIMIT_BYTES=12582912
# NODE_ENV=production
# ALLOW_BIND_ALL=true
# 空库首次启动 API 时必填（≥12 字符，禁止 admin123 等弱口令）
# ADMIN_INITIAL_USERNAME=admin
# ADMIN_INITIAL_PASSWORD=replace-with-strong-password-min-12-chars

# 大模型（可选；密钥仅存 API 进程，浏览器不保存）
# LLM_API_KEY=sk-...
# LLM_BASE_URL=
# LLM_MODEL=

# 标签/产品目录保存后是否自动写 public/config 备份（生产默认开，开发默认关）
# AUTO_PUBLISH_CONFIG=true
